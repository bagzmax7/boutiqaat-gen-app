# Supabase (Database & Auth)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# RunningHub API Keys
RUNNINGHUB_API_KEY_ENTERPRISE=your_runninghub_enterprise_api_key_here
RUNNINGHUB_API_KEY_CONSUMER=your_runninghub_consumer_api_key_here
# Optional fallback if single key is used
RUNNINGHUB_API_KEY=

# Override control: Set to 'enterprise' or 'consumer' to bypass auto-detection. Leave blank for auto-detection.
RUNNINGHUB_FORCE_KEY_TYPE=

# RunningHub Base URLs (Optional, defaults will be used if left blank)
RUNNINGHUB_BASE_URL=https://www.runninghub.ai
RUNNINGHUB_UPLOAD_URL=https://www.runninghub.cn

# Team Authentication
AUTH_USERNAME=editor
AUTH_PASSWORD=your_secure_password_here
AUTH_SECRET=your_random_secret_string_here

# App Config
NEXT_PUBLIC_APP_NAME=Boutiqaat Gen-App
PINNED_APP_ID=2054414719020216321

# Google Gemini API (Image Generation + Multimodal Analysis)
GEMINI_API_KEY=your_gemini_api_key_here
