# ==============================================================================
# BOUTIQAAT CREATIVE AI STUDIO - ENVIRONMENT TEMPLATE (RELEASE 1)
# Copy this file to .env.local and adjust your settings:
#   cp .env.example .env.local
# ==============================================================================

# ── 1. Database Engine (100% Local File Database) ─────────────────────────────
USE_LOCAL_DB=true
LOCAL_DB_PATH="./database"

# (Optional: If connecting to PostgreSQL / AWS RDS / Aurora)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/boutiqaat_studio

# ── 2. RunningHub AI Generation API Keys ──────────────────────────────────────
RUNNINGHUB_API_KEY_ENTERPRISE=your_enterprise_api_key_here
RUNNINGHUB_API_KEY_CONSUMER=your_consumer_api_key_here
RUNNINGHUB_BASE_URL=https://www.runninghub.cn
RUNNINGHUB_FORCE_KEY_TYPE=

# ── 3. Authentication & Security Secrets ──────────────────────────────────────
AUTH_USERNAME=editor
AUTH_PASSWORD=toTheMax
AUTH_SECRET=bqa_gen_app_secret_2026_xK9mPqR3
WEBHOOK_SECRET=bqa_wh_secret_2026_xR7kNpM4

# ── 4. Microsoft Graph SSO / Azure Entra ID ───────────────────────────────────
# NEXT_PUBLIC_MS_GRAPH_CLIENT_ID=your_azure_client_id
# MS_GRAPH_CLIENT_SECRET=your_azure_client_secret
# MS_GRAPH_TENANT_ID=your_azure_tenant_id

# ── 5. STUDIO BRANDING ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Boutiqaat Creative AI Studio"

# ── 6. Bundling Studio & AI Fallback Models ───────────────────────────────────
HF_TOKEN=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
